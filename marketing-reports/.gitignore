# =============================================================================
# .gitignore — marketing-reports
# =============================================================================

# Secrets — NEVER commit these
.env
config/credentials.yaml
config/ga4_service_account.json
*.pem
*.p12
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Data / Cache / Logs
data/cache/*
logs/*.log
logs/*.log.*
!data/cache/.gitkeep
!logs/.gitkeep

# Reports output (generated files)
data/reports/

# Jupyter
.ipynb_checkpoints/
*.ipynb
