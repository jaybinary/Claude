# =============================================================================
# credentials.yaml.example
# Rentokil PCI HiCare — Automated Marketing Reports
# =============================================================================
# HOW TO USE:
#   cp config/credentials.yaml.example config/credentials.yaml
#   Then fill in your real values in credentials.yaml one section at a time.
#   credentials.yaml is gitignored — your secrets will never be committed.
# =============================================================================


# =============================================================================
# 1. GOOGLE ADS API
# =============================================================================
# Docs      : https://developers.google.com/google-ads/api/docs/start
# Console   : https://ads.google.com → Tools & Settings → API Center
# OAuth     : https://console.cloud.google.com → APIs & Services → Credentials
# =============================================================================
google_ads:
  developer_token:    "REPLACE_WITH_GOOGLE_ADS_DEVELOPER_TOKEN"
  # OAuth2 credentials (Desktop app type)
  client_id:          "REPLACE_WITH_OAUTH_CLIENT_ID"            # ends in .apps.googleusercontent.com
  client_secret:      "REPLACE_WITH_OAUTH_CLIENT_SECRET"
  refresh_token:      "REPLACE_WITH_OAUTH_REFRESH_TOKEN"
  # Google Ads account
  customer_id:        "REPLACE_WITH_CUSTOMER_ID"                # digits only, e.g. 1234567890
  login_customer_id:  ""                                         # MCC account ID — leave blank if none
  # Status: [ ] Not yet filled in
  # Filled:  [ ] developer_token  [ ] client_id  [ ] client_secret
  #          [ ] refresh_token    [ ] customer_id


# =============================================================================
# 2. META (FACEBOOK / INSTAGRAM) ADS API
# =============================================================================
# Docs      : https://developers.facebook.com/docs/marketing-api
# Console   : https://developers.facebook.com → Your App → Marketing API
# Token     : https://developers.facebook.com/tools/explorer/
# =============================================================================
meta_ads:
  app_id:             "REPLACE_WITH_META_APP_ID"
  app_secret:         "REPLACE_WITH_META_APP_SECRET"
  access_token:       "REPLACE_WITH_META_LONG_LIVED_ACCESS_TOKEN"  # valid 60 days
  ad_account_id:      "REPLACE_WITH_AD_ACCOUNT_ID"               # include "act_" prefix, e.g. act_123456789
  # Status: [ ] Not yet filled in
  # Filled:  [ ] app_id  [ ] app_secret  [ ] access_token  [ ] ad_account_id


# =============================================================================
# 3. SHOPIFY ADMIN API
# =============================================================================
# Docs      : https://shopify.dev/docs/api/admin-rest
# Setup     : Shopify Admin → Settings → Apps → Develop apps → Create app
# Scopes    : read_orders, read_products, read_analytics
# =============================================================================
shopify:
  store_url:          "pci-hicare.myshopify.com"                 # pre-filled — do NOT include https://
  api_version:        "2024-01"
  access_token:       "REPLACE_WITH_SHOPIFY_ADMIN_API_ACCESS_TOKEN"
  # Status: [ ] Not yet filled in
  # Filled:  [ ] access_token


# =============================================================================
# 4. GOOGLE ANALYTICS 4 (GA4)
# =============================================================================
# Docs      : https://developers.google.com/analytics/devguides/reporting/data/v1
# Console   : https://console.cloud.google.com → APIs → Google Analytics Data API
# Setup     : Create Service Account → Download JSON key → Add to GA4 Property
# =============================================================================
google_analytics:
  property_id:            "REPLACE_WITH_GA4_PROPERTY_ID"         # numeric only, e.g. 123456789
  service_account_json:   "config/ga4_service_account.json"      # path to downloaded key file
  use_service_account:    true
  # Status: [ ] Not yet filled in
  # Filled:  [ ] property_id  [ ] ga4_service_account.json placed in config/


# =============================================================================
# 5. EMAIL (SMTP)
# =============================================================================
# Gmail setup : Google Account → Security → App Passwords → Generate
# Alternative : SendGrid, Mailgun, AWS SES (change smtp_host accordingly)
# =============================================================================
email:
  smtp_host:          "smtp.gmail.com"
  smtp_port:          587
  smtp_use_tls:       true
  sender_email:       "REPLACE_WITH_SENDER_EMAIL"                # e.g. reports@pci-hicare.com
  sender_name:        "PCI HiCare Marketing Reports"
  sender_password:    "REPLACE_WITH_GMAIL_APP_PASSWORD"          # 16-char App Password (not login password)

  recipients:
    daily:
      - "REPLACE_WITH_DAILY_RECIPIENT_1"                         # e.g. marketing@pci-hicare.com
      - "REPLACE_WITH_DAILY_RECIPIENT_2"
    weekly:
      - "REPLACE_WITH_WEEKLY_RECIPIENT_1"
      - "REPLACE_WITH_WEEKLY_RECIPIENT_2"
      - "REPLACE_WITH_WEEKLY_RECIPIENT_3"
    monthly:
      - "REPLACE_WITH_MONTHLY_RECIPIENT_1"
      - "REPLACE_WITH_MONTHLY_RECIPIENT_2"
      - "REPLACE_WITH_MONTHLY_RECIPIENT_3"
      - "REPLACE_WITH_MONTHLY_RECIPIENT_4"
  # Status: [ ] Not yet filled in
  # Filled:  [ ] sender_email  [ ] sender_password  [ ] recipients


# =============================================================================
# 6. WHATSAPP
# =============================================================================
# Choose ONE provider: "meta" (free, recommended) or "twilio"
# Meta Cloud API : https://developers.facebook.com → WhatsApp → Getting Started
# Twilio         : https://console.twilio.com → Messaging → WhatsApp
# =============================================================================
whatsapp:
  provider:           "meta"                                     # "meta" or "twilio"

  # --- Option A: Meta WhatsApp Cloud API (recommended) ---
  meta:
    phone_number_id:  "REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID"
    access_token:     "REPLACE_WITH_WHATSAPP_ACCESS_TOKEN"       # can reuse Meta Ads token
    api_version:      "v18.0"

  # --- Option B: Twilio WhatsApp (fill only if provider = "twilio") ---
  twilio:
    account_sid:      "REPLACE_WITH_TWILIO_ACCOUNT_SID"
    auth_token:       "REPLACE_WITH_TWILIO_AUTH_TOKEN"
    from_number:      "whatsapp:+14155238886"                    # Twilio sandbox number

  # Recipients (international format with country code)
  recipients:
    - "+91REPLACE_NUMBER_1"                                      # e.g. +919999999999
    - "+91REPLACE_NUMBER_2"
  # Status: [ ] Not yet filled in
  # Filled:  [ ] provider chosen  [ ] phone_number_id  [ ] access_token  [ ] recipients
